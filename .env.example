# Which AI to use: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# --- Gemini (AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_API_KEY_FOR_CAPTION=
# Optional, defaults to gemini-3-flash-preview
GEMINI_MODEL=

# --- OpenAI (AI_PROVIDER=openai) ---
OPENAI_API_KEY=
# Required: chat model used to find segments and write descriptions
OPENAI_MODEL=
# Optional, defaults to whisper-1. Must support SRT output; captions also use
# the translation endpoint, which only whisper-1 supports.
OPENAI_TRANSCRIBE_MODEL=
# Optional, defaults to https://api.openai.com/v1 (set for OpenAI-compatible APIs)
OPENAI_BASE_URL=
